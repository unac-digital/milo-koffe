---
import { Picture } from 'astro:assets';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Icon from '../components/Icon.astro';
import Bird from '../components/Bird.astro';
import ModelSteps from '../components/ModelSteps.astro';
import BrandGallery from '../components/BrandGallery.astro';
import { pageUrl, type Locale } from '../i18n/routes';
import { t } from '../i18n/ui';
import ciclista from '../assets/photos/ciclista.jpg';
import graos from '../assets/photos/graos.jpg';

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const s = t(lang);
const inv = s.investors;
---
<Header lang={lang} page="investors" variant="overlay" />

<main id="conteudo">
  <section class="intro on-dark">
    <div class="wrap intro-grid">
      <div class="intro-copy">
        <h1 class="display">{inv.title}</h1>
        <p class="intro-sub">{inv.sub}</p>
        <a class="link-arrow" href="#contato"><span>{s.close.talk}</span> <Icon name="arrow" /></a>
      </div>
      <Picture
        src={ciclista}
        alt={s.floripa.alt}
        formats={['avif', 'webp']}
        widths={[480, 720, 1000]}
        sizes="(max-width: 900px) 100vw, 40vw"
        loading="eager"
        class="photo intro-img"
      />
    </div>
  </section>

  <section class="concept">
    <div class="wrap concept-grid">
      <h2 class="display h2">{inv.conceptTitle}</h2>
      <div class="concept-body">
        {inv.conceptBody.map((p) => <p class="lead">{p}</p>)}
      </div>
    </div>
    <ul class="wrap pillars" role="list">
      {inv.pillars.map((p, i) => (
        <li>
          {i > 0 && <Bird width={40} class="pillar-bird" />}
          <span class="display">{p}</span>
        </li>
      ))}
    </ul>
  </section>

  <section class="model">
    <div class="wrap split">
      <div class="stack">
        <h2 class="display h2">{inv.modelTitle}</h2>
        <p class="lead">{inv.modelBody}</p>
        <ModelSteps steps={s.model.steps} />
        <a class="link-arrow green" href={pageUrl('menu', lang)}><span>{s.serve.cta}</span> <Icon name="arrow" /></a>
      </div>
      <Picture
        src={graos}
        alt={s.serve.alt}
        formats={['avif', 'webp']}
        widths={[480, 720, 1000]}
        sizes="(max-width: 900px) 100vw, 45vw"
        class="photo model-img"
        loading="lazy"
      />
    </div>
  </section>

  <section class="values on-dark">
    <div class="wrap">
      <h2 class="display h2 values-title">{inv.valueTitle}</h2>
      <ul class="values-list">
        {inv.values.map((v) => (
          <li>
            <h3 class="display">{v.title}</h3>
            <p>{v.text}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="brand">
    <div class="wrap">
      <div class="brand-head">
        <h2 class="display h2">{s.brand.title}</h2>
        <p class="lead">{s.brand.body}</p>
      </div>
      <BrandGallery lang={lang} />
    </div>
  </section>

  <section id="contato" class="contact on-dark">
    <div class="wrap"><div class="stack">
      <Bird width={64} />
      <h2 class="display contact-title">{inv.contactTitle}</h2>
      <p class="lead">{inv.contactBody}</p>
      <p class="pending">{inv.contactPending}</p>
    </div></div>
  </section>
</main>

<Footer lang={lang} page="investors" />

<style>
  .h2 {
    font-size: var(--step-1);
    line-height: 1.04;
    color: var(--green);
  }

  .lead {
    font-size: var(--body-l);
    line-height: 1.6;
    color: var(--ink-soft);
    max-width: 34em;
  }

  .stack {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 28px;
  }

  .green {
    color: var(--green);
  }

  .intro {
    background: var(--green);
    color: var(--oat);
    padding-top: calc(var(--header-h) + 72px);
    padding-bottom: clamp(72px, 8vw, 120px);
  }

  .intro-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
    gap: clamp(40px, 6vw, 96px);
    align-items: end;
  }

  .intro-copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 28px;
  }

  .intro h1 {
    font-size: var(--step-hero);
    line-height: 1;
    max-width: 9em;
  }

  .intro-sub {
    max-width: 28em;
    font-size: clamp(1.0625rem, 0.95rem + 0.5vw, 1.3125rem);
    line-height: 1.5;
    color: var(--on-dark-soft);
  }

  .intro :global(.intro-img) {
    height: clamp(340px, 40vw, 580px);
    object-position: center 28%;
  }

  .concept {
    padding-block: var(--section-y);
  }

  .concept-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 32px clamp(40px, 6.7vw, 96px);
    align-items: start;
  }

  .concept-body {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .pillars {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px 28px;
    margin-top: clamp(56px, 7vw, 96px);
    padding-top: clamp(40px, 5vw, 64px);
    border-top: 1px solid var(--line);
  }

  .pillars li {
    display: flex;
    align-items: center;
    gap: 28px;
    font-size: clamp(2rem, 1.4rem + 2.6vw, 4rem);
    line-height: 1.05;
    color: var(--green);
  }

  .pillars :global(.pillar-bird) {
    color: var(--espresso);
  }

  .model {
    padding-block: 0 var(--section-y);
  }

  .split {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(40px, 6.7vw, 96px);
    align-items: center;
  }

  .split .stack {
    max-width: 560px;
  }

  .model :global(.model-img) {
    height: clamp(300px, 44vw, 640px);
  }

  .values {
    padding-block: var(--section-y);
    background: var(--green);
    color: var(--oat);
  }

  .values-title {
    color: var(--oat);
    max-width: 12em;
    margin-bottom: clamp(48px, 5vw, 72px);
  }

  .values-list {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .values-list li {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: 28px 36px 8px 0;
    border-top: 1px solid rgb(232 225 205 / 0.3);
  }

  .values-list li + li {
    padding-left: 36px;
    border-left: 1px solid rgb(232 225 205 / 0.3);
  }

  .values-list h3 {
    font-size: clamp(1.5rem, 1.2rem + 1vw, 2.125rem);
    line-height: 1.1;
  }

  .values-list p {
    font-size: var(--body-l);
    line-height: 1.55;
    color: var(--on-dark-soft);
  }

  .brand {
    padding-block: var(--section-y);
  }

  .brand-head {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 460px);
    gap: 22px 96px;
    align-items: end;
    margin-bottom: 64px;
  }

  .contact {
    padding-block: clamp(88px, 9vw, 130px);
    background: var(--espresso);
    color: var(--oat);
  }

  .contact .stack {
    gap: 26px;
  }

  .contact-title {
    font-size: clamp(2.625rem, 1.6rem + 3.6vw, 4.75rem);
    line-height: 1;
  }

  .contact .lead {
    color: var(--on-dark-soft);
  }

  .pending {
    display: inline-flex;
    align-items: center;
    min-height: 56px;
    padding: 0 28px;
    border-radius: 999px;
    border: 1px dashed rgb(232 225 205 / 0.5);
    font-weight: 600;
  }

  @media (max-width: 900px) {
    .intro {
      padding-top: calc(var(--header-h) + 40px);
    }

    .intro-grid,
    .concept-grid,
    .split,
    .brand-head {
      grid-template-columns: minmax(0, 1fr);
    }

    .pillars {
      flex-direction: column;
      align-items: flex-start;
    }

    .pillars li {
      gap: 16px;
    }

    .pillars :global(.pillar-bird) {
      display: none;
    }

    .values-list {
      grid-template-columns: minmax(0, 1fr);
    }

    .values-list li,
    .values-list li + li {
      padding: 24px 0;
      border-left: 0;
    }

    .brand-head {
      margin-bottom: 32px;
    }
  }
</style>
