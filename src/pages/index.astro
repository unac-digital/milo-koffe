---
/*
 * Raiz do site: serve a versão em português, sem redirecionar (recomendação do Google).
 * O canonical aponta para /pt/ e o aviso de idioma sugere EN/ES a quem tiver o navegador nesses idiomas.
 */
import Base from '../layouts/Base.astro';
import HomeView from '../views/HomeView.astro';
import { absolute, pageUrl } from '../i18n/routes';
import { t } from '../i18n/ui';

const s = t('pt');
---
<Base lang="pt" page="home" title={s.meta.homeTitle} description={s.meta.homeDescription} canonical={absolute(pageUrl('home', 'pt'))}>
  <HomeView lang="pt" />
</Base>
