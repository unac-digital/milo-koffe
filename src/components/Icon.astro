---
interface Props {
  name: 'arrow' | 'globe' | 'info' | 'menu' | 'close';
  size?: number;
}
const { name, size = 20 } = Astro.props;
---
<svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width={name === 'arrow' ? 2 : 1.8} stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {name === 'arrow' && (<><path d="M5 12h14"></path><path d="M13 6l6 6-6 6"></path></>)}
  {name === 'globe' && (<><circle cx="12" cy="12" r="9"></circle><path d="M3 12h18"></path><path d="M12 3a14 14 0 0 1 0 18a14 14 0 0 1 0-18z"></path></>)}
  {name === 'info' && (<><circle cx="12" cy="12" r="9"></circle><path d="M12 11v5"></path><path d="M12 8h.01"></path></>)}
  {name === 'menu' && (<><path d="M4 8h16"></path><path d="M4 16h16"></path></>)}
  {name === 'close' && (<><path d="M6 6l12 12"></path><path d="M18 6L6 18"></path></>)}
</svg>
