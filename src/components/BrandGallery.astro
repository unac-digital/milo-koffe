---
import { Picture } from 'astro:assets';
import type { Locale } from '../i18n/routes';
import { t } from '../i18n/ui';
import copos from '../assets/photos/copos.jpg';
import aventalCopo from '../assets/photos/avental-copo.jpg';
import caixa from '../assets/photos/caixa.jpg';
import boneEcobag from '../assets/photos/bone-ecobag.jpg';

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const a = t(lang).brand.alts;
const formats: ('avif' | 'webp')[] = ['avif', 'webp'];
const widths = [480, 800, 1200, 1620];
---
<div class="gallery">
  <Picture src={copos} alt={a.cups} formats={formats} widths={widths} sizes="(max-width: 900px) 100vw, 58vw" class="photo g-cups" loading="lazy" />
  <Picture src={aventalCopo} alt={a.cup} formats={formats} widths={widths} sizes="(max-width: 900px) 100vw, 42vw" class="photo g-cup" loading="lazy" />
  <Picture src={caixa} alt={a.box} formats={formats} widths={widths} sizes="(max-width: 900px) 50vw, 42vw" class="photo g-box" loading="lazy" />
  <Picture src={boneEcobag} alt={a.merch} formats={formats} widths={widths} sizes="(max-width: 900px) 50vw, 58vw" class="photo g-merch" loading="lazy" />
</div>

<style>
  .gallery {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 24px;
  }

  .gallery > :global(picture:nth-child(1)),
  .gallery > :global(picture:nth-child(4)) {
    grid-column: span 7;
  }

  .gallery > :global(picture:nth-child(2)),
  .gallery > :global(picture:nth-child(3)) {
    grid-column: span 5;
  }

  .gallery :global(.g-cups),
  .gallery :global(.g-cup) {
    height: clamp(260px, 37.5vw, 540px);
  }

  .gallery :global(.g-cup) {
    object-position: 88% center;
  }

  .gallery :global(.g-box),
  .gallery :global(.g-merch) {
    height: clamp(200px, 27.8vw, 400px);
  }

  @media (max-width: 900px) {
    .gallery {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 20px;
    }

    .gallery > :global(picture:nth-child(1)),
    .gallery > :global(picture:nth-child(2)) {
      grid-column: 1 / -1;
    }

    .gallery > :global(picture:nth-child(3)),
    .gallery > :global(picture:nth-child(4)) {
      grid-column: span 1;
    }

    .gallery :global(.g-merch) {
      object-position: 22% center;
    }
  }
</style>
